<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AssemblyName>EtabsConnector</AssemblyName>
    <RootNamespace>EtabsConnector</RootNamespace>
    <EtabsPath Condition="'$(EtabsPath)' == ''">C:\Program Files\Computers and Structures\ETABS 23</EtabsPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="ETABSv1">
      <HintPath>$(EtabsPath)\ETABSv1.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
